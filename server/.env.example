# Kachok API sozlamalari. Nusxa oling: cp .env.example .env
# Bo'sh qoldirilgan majburiy qiymatlar bilan server ishga tushmaydi — bu ataylab.

PORT=8787
# PostgreSQL. Bo'sh qoldirilsa — ichki PGlite (faqat ishlab chiqish uchun).
# docker compose bilan DATABASE_URL avtomatik beriladi (POSTGRES_PASSWORD dan).
DATABASE_URL=
# PGLITE_DIR=./data

# docker compose uchun Postgres paroli (majburiy, standart qiymati yo'q): openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT kaliti — majburiy, kamida 32 belgili TASODIFIY qator. Yarating: openssl rand -base64 48
# Namunaviy yoki oddiy qiymat bilan server ishga tushmaydi. Kalit almashtirilsa, barcha sessiyalar bekor bo'ladi.
JWT_SECRET=

APP_URL=https://kachok.uz
CORS_ORIGINS=https://kachok.uz

# API nginx/Caddy ortida bo'lsa (docker compose bilan — albatta) 1 qiling: mijoz IP manzili
# X-Forwarded-For'ning eng o'ng qiymatidan olinadi. Proksisiz 1 qilmang — aks holda IP'ni soxtalashtirish mumkin.
TRUST_PROXY=0

# SMS: eskiz (Eskiz.uz). Ishlab chiqishda: SMS_PROVIDER=console va DEV_MODE=1 (kod konsolga yoziladi va javobda qaytadi).
# DEV_MODE=1 production'da (NODE_ENV=production, `npm start` va Docker) taqiqlangan.
SMS_PROVIDER=eskiz
DEV_MODE=0
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Butun server bo'yicha soatiga ko'pi bilan shuncha SMS (SMS-pamping hujumidan himoya)
SMS_GLOBAL_PER_HOUR=500

# Payme (merchant kabinetidan). PAYME_TEST majburiy: 0 — haqiqiy to'lovlar, 1 — test.paycom.uz
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=0

# Click (merchant kabinetidan)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

TRIAL_DAYS=7
