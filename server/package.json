{
  "name": "kachok-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kachok API: akkaunt (telefon + SMS kod), bulutli saqlash, murabbiy rejimi, Payme/Click to'lovlari",
  "scripts": {
    "dev": "npm run build && node --enable-source-maps --watch-path=dist dist/index.js",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json && cp -r src/db/migrations dist/db/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
