# Ilova (veb) sozlamalari. Nusxa oling: cp .env.example .env.local

# API server manzili. Bo'sh qoldirilsa — akkauntsiz, faqat telefonda ishlaydi
VITE_API_URL=http://localhost:8787

# 1 — Pro imkoniyatlari pullik bo'ladi (Payme/Click ulangandan keyin yoqing).
# Bo'sh — hammasi bepul ochiq
VITE_BILLING=

# Telegram bot nomi (@siz) va Mini App qisqa nomi (bo'lsa): do'st taklif havolasi t.me/<bot>?startapp=... bo'ladi.
# Bo'sh — taklif havolasi sayt manzili bilan
VITE_TG_BOT=
VITE_TG_APP=
